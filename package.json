{
  "name": "culinola",
  "version": "0.0.0",
  "private": true,
  "description": "Modularer Infobildschirm fürs Zuhause – Haustechnik, Medien und Alltag auf einem Touch-Bildschirm.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "start": "node packages/core/src/main.ts",
    "dev:ui": "npm run dev -w @culinola/ui",
    "build": "npm run build -w @culinola/ui",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p packages/ui/tsconfig.json --noEmit",
    "token": "node packages/core/src/token.ts",
    "google:login": "node plugins/source-google/src/login.ts",
    "recipes:import": "node packages/recipe-import/src/cli.ts",
    "test": "vitest run",
    "test:instance": "node testing/start.mjs",
    "licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;MIT-0;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;Unlicense;CC0-1.0;OFL-1.1\"",
    "check": "npm run typecheck && npm run test && npm run licenses"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
