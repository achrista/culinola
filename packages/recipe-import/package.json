{
  "name": "@culinola/recipe-import",
  "version": "0.0.0",
  "private": true,
  "description": "Wandelt Rezepte aus Dokumenten und Webseiten mit Claude Haiku in das Rezeptformat von Culinola und Merkio um. Vorläufig abgelegt, noch nicht eingebunden.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dist": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "recipe-import": "./src/cli.ts"
  },
  "scripts": {
    "convert": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "fflate": "^0.8.2",
    "word-extractor": "^1.0.4",
    "yaml": "^2.9.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/word-extractor": "^1.0.6"
  }
}
